# DiseaseGene Application Test Environment Configuration Example
# Copy to .env for local test execution. In CI, use GitHub Secrets.

# Web Application (Selenium)
BASE_URL=http://localhost:3000
TEST_USERNAME=test_researcher
TEST_PASSWORD=TestPassword123!
ADMIN_USERNAME=test_admin
ADMIN_PASSWORD=AdminPassword123!
HEADLESS=true
SELENIUM_BROWSER=chrome
SELENIUM_IMPLICIT_WAIT=10

# Mobile Testing (Appium)
APPIUM_SERVER_URL=http://localhost:4723
ANDROID_APP_PATH=frontend/android/app/build/outputs/apk/debug/app-debug.apk
ANDROID_DEVICE_NAME=emulator-5554
ANDROID_PLATFORM_VERSION=13.0
ANDROID_APP_PACKAGE=com.romcom.diseasegenemap
ANDROID_APP_ACTIVITY=.MainActivity
APPIUM_COMMAND_TIMEOUT=60

# Load Testing (k6)
LOAD_TEST_BASE_URL=http://localhost:8000
LOAD_TEST_PROFILE=smoke
LOAD_TEST_VUS=10
LOAD_TEST_DURATION=30s

# Security / Vulnerability Testing
SECURITY_TEST_TARGET=http://localhost:8000
ZAP_BASELINE_URL=http://localhost:8000
ZAP_PORT=8080
SCAN_TYPE=fast
